# ── Environment Variables ─────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GPS_TOPIC=gps-events
SENSOR_TOPIC=sensor-events
CONGESTION_TOPIC=congestion-results

# Producers
NUM_VEHICLES=30
GPS_PUBLISH_INTERVAL_S=2.0
SENSOR_PUBLISH_INTERVAL_S=5.0

# Spark streaming windows (seconds)
WINDOW_DURATION_S=60
SLIDE_DURATION_S=30
WATERMARK_DELAY_S=30

# Congestion scoring thresholds (0–100 scale)
CONGESTION_LOW_THRESHOLD=25
CONGESTION_MODERATE_THRESHOLD=50
CONGESTION_HIGH_THRESHOLD=75

# Database
DB_PATH=./data/traffic.db

# Backend
ROUTE_REFRESH_INTERVAL_S=30

# Checkpointing
CHECKPOINT_DIR=./checkpoints

# Frontend (set for Docker, override for local dev)
REACT_APP_API_URL=http://localhost:8000
